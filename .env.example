# URL y clave pública del proyecto de Supabase (Project Settings → API).
# La clave pública solo se usa en el navegador para subir archivos con links firmados: la base no tiene acceso público.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave service_role: SOLO servidor. Toda lectura y escritura de datos pasa por acá.
# Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la app (la que va en los QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contraseña única de la app (hash bcrypt en base64). Se genera con:  npm run hash-password
# Con  npm run hash-password -- --local  se guarda sola en .env.local.
APP_PASSWORD_HASH=JDJiJDEyJ...

# Secreto para firmar la cookie de sesión (al menos 32 caracteres al azar).
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si lo cambiás, se cierran todas las sesiones abiertas.
SESSION_SECRET=...
