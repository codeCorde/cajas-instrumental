# URL y clave pública del proyecto de Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave service_role: SOLO servidor. Se usa para invitar usuarios desde /admin/usuarios.
# Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la app (para el QR y el link de las invitaciones)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
